# Which port the 100mph API is on. Default 8080; the host is inferred from the
# Metro connection so a physical device reaches your dev machine, not itself.
EXPO_PUBLIC_API_PORT=8080

# Pin an exact base URL instead. Required for any release build.
# EXPO_PUBLIC_API_BASE_URL=https://api.100mph.in/v1

# Where the demonstration videos and posters are served from, no trailing slash.
# A zero-egress bucket behind a CDN. Files come from scripts/encode-demos.sh.
# Leave it unset and the app renders its "coming soon" placeholders instead.
# EXPO_PUBLIC_MEDIA_BASE_URL=https://media.100mph.in
